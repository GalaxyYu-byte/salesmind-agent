# 在项目根目录复制为 .env；系统环境变量优先于 .env。
SALESMIND_APP_NAME="SalesMind Agent"

# 销售接口必须携带已登录账号的 Access Token。
SALESMIND_SALES_QUERY_TIMEOUT=10

# 两项同时留空可启动 /health/live；配置后按需连接数据库。
# 分别使用专用只读账号和应用读写账号，运行服务不使用建表/迁移管理账号。
# 密码含 @、:、/、#、% 等字符时，必须先做 URL 百分号编码。
# 业务库示例：mysql+asyncmy://sales_reader:REPLACE_ME@127.0.0.1:3306/sales_data
# 应用库示例：mysql+asyncmy://agent_writer:REPLACE_ME@127.0.0.1:3306/agent_app
SALESMIND_SALES_DATABASE_URL=
SALESMIND_APP_DATABASE_URL=

# 当前只有 root 的开发环境可显式设为 true，允许两个 schema 共用账号。
# 创建独立运行账号后改回 false。
SALESMIND_ALLOW_SHARED_DATABASE_ACCOUNT=false

# 仅 Alembic 命令读取；管理/迁移账号需拥有两个 schema 的建表与结构修改权限。
# 示例：mysql+asyncmy://migration_admin:REPLACE_ME@127.0.0.1:3307/agent_app
SALESMIND_MIGRATION_DATABASE_URL=

# 按部署说明，本机通过 SSH 隧道连接；密码必须做 URL 百分号编码。
# Redis 示例：redis://:REPLACE_ME@127.0.0.1:6380/0
SALESMIND_REDIS_URL=
SALESMIND_REDIS_MAX_CONNECTIONS=20
SALESMIND_REDIS_CONNECT_TIMEOUT=3
SALESMIND_REDIS_SOCKET_TIMEOUT=3
SALESMIND_HEALTH_CHECK_TIMEOUT=5

# 每个数据库连接池的参数；两个池的最大连接数合计为 2 * (size + overflow)。
SALESMIND_DB_POOL_SIZE=5
SALESMIND_DB_MAX_OVERFLOW=5
SALESMIND_DB_POOL_TIMEOUT=30
SALESMIND_DB_POOL_RECYCLE=1800
SALESMIND_DB_CONNECT_TIMEOUT=10

# JWT 密钥使用至少 32 字节随机值，不能提交到 Git；留空时登录接口返回 503。
SALESMIND_AUTH_JWT_SECRET=
SALESMIND_AUTH_ACCESS_SECONDS=1800
SALESMIND_AUTH_REFRESH_SECONDS=604800
# 生产 HTTPS 必须 true；仅本机 HTTP 联调设置 false。
SALESMIND_AUTH_COOKIE_SECURE=true
# JSON 数组；生产部署改成实际前端来源。不启用跨域 CORS。
SALESMIND_AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
